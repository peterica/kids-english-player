# ─────────────────────────────────────────────────────────────
# 필수: 로그인 세션 쿠키 서명 키
#   openssl rand -hex 48
# Docker 로 실행할 때 이 값이 없으면 컨테이너가 기동하지 않는다.
# ─────────────────────────────────────────────────────────────
SESSION_SECRET="change-me-to-a-long-random-string"

# SQLite 파일 위치 (prisma/schema.prisma 기준 상대 경로 → <project>/data/app.db)
# ※ Docker 로 실행할 때는 이 값이 쓰이지 않는다.
#    docker-compose.yml 이 컨테이너 내부 경로(file:/app/data/app.db)로 덮어쓰며,
#    실제 파일은 볼륨 마운트로 호스트의 ./data/app.db 에 남는다.
DATABASE_URL="file:../data/app.db"

# HTTPS 로 서비스할 때만 "true". LAN(HTTP) 접속에서는 비워 둔다.
# COOKIE_SECURE="false"

# Docker 실행 시 호스트 포트 (기본 3200). 컨테이너 내부 포트는 항상 3200.
# PORT="3200"

# Docker 실행 시 타임존 (기본 Asia/Seoul)
# TZ="Asia/Seoul"

# 읽기 전용 Content Library API(GET /api/content-library) 접근 토큰.
# 비워 두면 인증 없이 조회할 수 있다(공용 콘텐츠 메타데이터만 노출).
# 값을 넣으면 ?token=... 또는 Authorization: Bearer ... 가 필요하다.
# CONTENT_LIBRARY_TOKEN=""
