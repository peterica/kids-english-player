# SQLite 파일 위치 (prisma/schema.prisma 기준 상대 경로 → <project>/data/app.db)
DATABASE_URL="file:../data/app.db"

# 부모 모드 PIN (4~6자리). seed 실행 시 해시로 변환되어 DB에 저장됩니다.
# 최초 seed 이후에는 /admin 화면에서 변경할 수 있습니다.
PARENT_PIN="0000"

# 부모 로그인 세션 쿠키 서명 키. 운영 시 반드시 임의의 긴 문자열로 교체하세요.
SESSION_SECRET="change-me-to-a-long-random-string"
