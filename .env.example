# SQLite 파일 위치 (prisma/schema.prisma 기준 상대 경로 → <project>/data/app.db)
DATABASE_URL="file:../data/app.db"

# 로그인 세션 쿠키 서명 키. 운영 시 반드시 교체한다.
#   openssl rand -hex 48
SESSION_SECRET="change-me-to-a-long-random-string"

# HTTPS 로 서비스할 때만 "true". LAN(HTTP) 접속에서는 비워 둔다.
# COOKIE_SECURE="false"

# 읽기 전용 Content Library API(GET /api/content-library) 접근 토큰.
# 비워 두면 인증 없이 조회할 수 있다(공용 콘텐츠 메타데이터만 노출).
# 값을 넣으면 ?token=... 또는 Authorization: Bearer ... 가 필요하다.
# CONTENT_LIBRARY_TOKEN=""
