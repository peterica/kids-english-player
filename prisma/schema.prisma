generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 계정 / 가정 / 아이
// 보안 경계는 Household 다. 아이·Collection·시청기록 조회는 모두 이 단위로 제한한다.
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        HouseholdMember[]
  correctionRequests CorrectionRequest[]
}

model Household {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     HouseholdMember[]
  children    Child[]
  collections Collection[]
  videos      Video[]
}

model HouseholdMember {
  id          Int      @id @default(autoincrement())
  householdId Int
  userId      Int
  role        String   @default("PARENT")
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

model Child {
  id          Int      @id @default(autoincrement())
  householdId Int
  name        String
  avatarKey   String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  preference       ChildPreference?
  collections      Collection[]
  progress         VideoProgress[]
  sessions         WatchSession[]
  autoPlaySessions AutoPlaySession[]

  @@index([householdId])
}

/// 아이별 허용 Level 범위와 선호 Channel. 추천 / Browse / Auto Play 기본값으로 쓴다.
model ChildPreference {
  id        Int      @id @default(autoincrement())
  childId   Int      @unique
  minLevel  Int      @default(1)
  maxLevel  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child             Child                     @relation(fields: [childId], references: [id], onDelete: Cascade)
  preferredChannels ChildPreferredChannel[]
}

model ChildPreferredChannel {
  id           Int @id @default(autoincrement())
  preferenceId Int
  channelId    Int

  preference ChildPreference @relation(fields: [preferenceId], references: [id], onDelete: Cascade)
  channel    Channel         @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([preferenceId, channelId])
}

// ---------------------------------------------------------------------------
// Content Library (공용) + 가정이 직접 등록한 영상
// ---------------------------------------------------------------------------

model Channel {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  colorKey    String   @default("c1")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  videos            Video[]
  preferredBy       ChildPreferredChannel[]
  autoPlaySessions  AutoPlaySession[]
}

model Video {
  id              Int      @id @default(autoincrement())
  youtubeVideoId  String   @unique
  youtubeUrl      String
  title           String
  /// 실제 YouTube 업로더(브랜드/내부 Channel 명이 아님)
  publisher       String
  thumbnailUrl    String?
  channelId       Int
  level           Int
  category        String
  durationSeconds Int?
  sequence        Int      @default(0)
  enabled         Boolean  @default(true)
  /// null 이면 서비스 공용 Library, 값이 있으면 그 가정만 볼 수 있는 직접 등록 영상
  householdId     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  channel           Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  household         Household?        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  collectionVideos    CollectionVideo[]
  progress            VideoProgress[]
  sessions            WatchSession[]
  autoPlaySessions    AutoPlaySession[]
  correctionRequests  CorrectionRequest[]

  @@index([channelId, level])
  @@index([householdId])
}

// ---------------------------------------------------------------------------
// My Collection (부모 개인화)
// ---------------------------------------------------------------------------

model Collection {
  id          Int      @id @default(autoincrement())
  householdId Int
  childId     Int?
  title       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child     Child?            @relation(fields: [childId], references: [id], onDelete: Cascade)
  videos    CollectionVideo[]

  @@index([householdId])
  @@index([childId])
}

model CollectionVideo {
  id           Int      @id @default(autoincrement())
  collectionId Int
  videoId      Int
  sequence     Int
  /// false 면 "이 영상은 우리 아이에게 보여주지 않음" (Library 원본은 그대로 둔다)
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([collectionId, videoId])
  @@index([collectionId, sequence])
}

// ---------------------------------------------------------------------------
// 시청 기록
// ---------------------------------------------------------------------------

model VideoProgress {
  id                  Int       @id @default(autoincrement())
  childId             Int
  videoId             Int
  status              String    @default("NOT_STARTED")
  lastPositionSeconds Int       @default(0)
  durationSeconds     Int       @default(0)
  progressPercent     Int       @default(0)
  watchSeconds        Int       @default(0)
  startedAt           DateTime?
  lastWatchedAt       DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([childId, videoId])
  @@index([childId, status])
}

model WatchSession {
  id                   Int       @id @default(autoincrement())
  childId              Int
  videoId              Int
  startedAt            DateTime  @default(now())
  endedAt              DateTime?
  startPositionSeconds Int       @default(0)
  endPositionSeconds   Int       @default(0)
  watchSeconds         Int       @default(0)
  createdAt            DateTime  @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([childId, startedAt])
}

// ---------------------------------------------------------------------------
// Auto Play (계속 틀어놓기)
// ---------------------------------------------------------------------------

model AutoPlaySession {
  id               Int       @id @default(autoincrement())
  childId          Int
  channelId        Int?
  minLevel         Int
  maxLevel         Int
  playMode         String    @default("SEQUENTIAL")
  replayCompleted  Boolean   @default(true)
  maxMinutes       Int?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  currentVideoId   Int?
  playedVideoCount Int       @default(0)

  child   Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  video   Video?   @relation(fields: [currentVideoId], references: [id], onDelete: SetNull)

  @@index([childId, startedAt])
}

/// 부모가 올린 Video 오류 수정 요청. Admin 이 처리한다.
model CorrectionRequest {
  id          Int       @id @default(autoincrement())
  videoId     Int
  requesterId Int
  errorType   String
  description String
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  video     Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([videoId])
  @@index([requesterId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
