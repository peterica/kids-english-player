# scripts/deploy.env 로 복사해 값을 채운다. 이 파일은 커밋되지 않는다.
DEPLOY_HOST="user@server"
DEPLOY_PATH="/path/to/kids-english-player"

# 기동 확인에 쓸 주소. 비우면 서버 내부(localhost:3200)에서 확인한다.
DEPLOY_URL=""

# 빌드 캐시 상한. 배포마다 쌓이는 캐시가 이 크기를 넘으면 오래된 것부터 지운다.
DEPLOY_CACHE_LIMIT="5GB"

# 원격에 보관할 DB 백업 개수 (오래된 것부터 삭제)
DEPLOY_BACKUP_KEEP="20"
